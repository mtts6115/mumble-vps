# ==============================================================================
# Mumble (Murmur) Server Configuration
# ==============================================================================

# Server Network Settings
MUMBLE_PORT=64738

# Administrative Password
# CRITICAL: Change this to a strong password before launching!
# Used to log in as "SuperUser" from the Mumble client.
MUMBLE_SUPERUSER_PASSWORD=ChangeMe_SuperUser_SecretPassword123!

# Server Access Password (Optional)
# Leave empty if you want your server to be public without a password.
MUMBLE_SERVER_PASSWORD=

# Server Identity & Display
MUMBLE_SERVER_NAME=My Community Mumble Server
MUMBLE_WELCOME_TEXT=<b>Welcome to our Mumble Server!</b><br>Enjoy low latency and crystal clear voice quality.

# Performance & Limits
# Maximum concurrent connected users
MUMBLE_MAX_USERS=100

# Voice Quality & Bandwidth (in bits per second)
# 72000 = Standard high quality (72 kbps)
# 96000 = Ultra high quality (96 kbps)
# 128000 = Extreme quality / Music (128 kbps)
MUMBLE_BANDWIDTH=96000

# Opus audio threshold percentage (100 = 100% opus codec allowed)
MUMBLE_OPUS_THRESHOLD=100
